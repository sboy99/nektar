# Nektar secrets — copy to .env and fill in. Never commit .env.
# Loaded automatically by config.Load (cwd). Optional: NEKTAR_ENV_FILE=/path/to/file
# OS environment variables always win over .env / .env.local.
#
# Per-user Gmail refresh tokens are stored in Postgres (gmail_sync.refresh_token),
# not in this file. Use nektar-gmail-auth and seed SQL from its output.

# Gmail OAuth app credentials
NEKTAR_GMAIL_CLIENT_ID=
NEKTAR_GMAIL_CLIENT_SECRET=

# Gemini
NEKTAR_GEMINI_API_KEY=

# Discord
NEKTAR_DISCORD_WEBHOOK_URL=

# Optional infrastructure overrides
# NEKTAR_POSTGRES_DSN=postgres://nektar:nektar@localhost:5432/nektar?sslmode=disable
# NEKTAR_REDIS_PASSWORD=
